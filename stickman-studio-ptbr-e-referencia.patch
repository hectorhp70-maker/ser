 LOG_LEVEL=INFO
+
+# --- Narration (edge-tts, local & free) ---
+# Brazilian-Portuguese neural voice. List all voices: `edge-tts --list-voices`.
+# Options: pt-BR-AntonioNeural (male), pt-BR-FranciscaNeural / pt-BR-ThalitaNeural (female).
+TTS_VOICE=pt-BR-AntonioNeural
+TTS_RATE=+0%             # speed, e.g. -10% (slower) or +15% (faster)
+TTS_PITCH=+0Hz           # pitch, e.g. -20Hz (lower) or +20Hz (higher)
+# Language Gemini writes the narration in (must match TTS_VOICE's language!).
+NARRATION_LANGUAGE=Brazilian Portuguese (português do Brasil)
+
+# --- Character reference (visual identity) — "Anderson Patrimônio" ---
+# Point this at a local image (the Anderson Patrimônio export from Canva) to make
+# Imagen keep that exact character across every scene. Leave blank to have Imagen
+# generate a plain stickman reference from the Gemini prompt instead.
+CHARACTER_REFERENCE_IMAGE=/absolute/path/to/anderson_patrimonio.png
+# Description of the referenced subject, used by Imagen subject-customization.
+# Anderson = a hand-drawn stickman with hair, an expressive face, shirt and tie.
+CHARACTER_SUBJECT_DESCRIPTION=a hand-drawn black line-art stickman man with short tousled spiky hair, an expressive face (eyes, eyebrows, nose, mouth), wearing a short-sleeved collared shirt and a necktie, thin stick arms and legs, monochrome black ink lines, no color fills
+# Negative prompt override. The project default forbids clothing/hair/detail,
+# which fights Anderson — this loosened version keeps line-art but allows him.
+CHARACTER_NEGATIVE_PROMPT=colorful character, saturated colors, photorealistic, 3d render, shadows, gradients, text, watermark, clutter, extra characters, background scenery clutter
+# Per-scene style constraints. Black ink line art on a solid CREAM background to
+# match the Anderson reference, while letting his hair/face/outfit through.
+CHARACTER_STYLE_CONSTRAINTS=hand-drawn black ink line art, monochrome line work, solid cream / warm off-white background, flat, no shading, no gradients
